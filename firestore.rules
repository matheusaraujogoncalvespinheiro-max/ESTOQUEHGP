// REGRAS DO FIRESTORE — projeto "erp-hospitalar" (Hospital Geral de Palmas)
//
// COMO IDENTIFICA O USUÁRIO: Firebase Auth (e-mail e senha). O nome de usuário é a parte do e-mail antes do "@" e o PERFIL fica no
// documento app_users/<usuário> (campos role, ativo, auth_email). Só vale se auth_email for IGUAL ao e-mail da conta: assim ninguém
// ganha acesso criando uma conta com o mesmo começo de e-mail. Não usa claims, então não precisa de Cloud Functions.
// ANTES DE PUBLICAR: crie o primeiro administrador (docs/firebase-conexao.md) ou todo o sistema fica bloqueado.
//
// Teste sempre no emulador antes de publicar:  firebase emulators:start --only firestore
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções ----------
    function usuario() { return request.auth.token.email.split('@')[0].lower(); }
    function cadastro() { return get(/databases/$(database)/documents/app_users/$(usuario())).data; }
    // Administrador raiz (bootstrap): a conta admin@admin.com é ADMIN mesmo sem documento em app_users. O e-mail é único no Firebase Auth,
    // então ninguém mais consegue essa conta enquanto ela existir. Se for apagada, remova esta linha ou recrie a conta antes de qualquer outra.
    function adminRaiz() { return request.auth != null && request.auth.token.email == 'admin@admin.com'; }
    function logado() {
      return adminRaiz() || (request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/app_users/$(usuario()))
        && cadastro().get('ativo', true) != false
        && cadastro().get('auth_email', '') == request.auth.token.email);
    }
    function perfil() { return adminRaiz() ? 'ADMIN' : cadastro().role; }
    function ehAdmin() { return logado() && perfil() == 'ADMIN'; }
    function temPerfil(lista) { return logado() && (perfil() == 'ADMIN' || perfil() in lista); }

    // Perfis e Permissões editáveis (#5): config_permissoes/<PERFIL> guarda só a diferença sobre as listas fixas abaixo ({ concede: [...], revoga: [...] }).
    // Só as coleções que chamam temAcao() leem isso (prontuário, leitos, laboratório, documentos, cirurgia, dieta, transfusão, óbito, manutenção, enfermagem e os anexos no Storage); as demais continuam presas às listas fixas de perfis.
    function permExiste() { return exists(/databases/$(database)/documents/config_permissoes/$(perfil())); }
    function permDoc() { return get(/databases/$(database)/documents/config_permissoes/$(perfil())).data; }
    function concedida(acao) { return permExiste() && acao in permDoc().concede; }
    function revogada(acao) { return permExiste() && acao in permDoc().revoga; }
    function temAcao(lista, acao) { return logado() && (perfil() == 'ADMIN' || concedida(acao) || (perfil() in lista && !revogada(acao))); }

    // Perfis por área
    function clinico() { return ['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_NIR']; }
    function internacao() { return ['FUNC_ENFERMAGEM', 'FUNC_RECEPCAO', 'FUNC_NIR']; }
    function leitos() { return ['FUNC_ENFERMAGEM', 'FUNC_HIGIENIZACAO', 'FUNC_RECEPCAO', 'MEDICO', 'FUNC_PORTARIA', 'CHEFE_PORTARIA', 'FUNC_NIR', 'FUNC_TRANSPORTE']; }
    function exames() { return ['MEDICO', 'FUNC_IMAGENOLOGIA', 'FUNC_ULTRASSOM', 'AUTORIZADOR', 'FUNC_ENFERMAGEM']; }
    function transporte() { return ['FUNC_NIR', 'FUNC_TRANSPORTE', 'MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_IMAGENOLOGIA', 'FUNC_ULTRASSOM', 'CHEFE_OPME', 'CHEFE_HEMODINAMICA']; }
    function estoque() { return ['CHEFE_OPME', 'FUNC_OPME', 'CHEFE_HEMODINAMICA', 'FUNC_HEMODINAMICA', 'FUNC_CENTRO_CIRURGICO', 'FUNC_ENFERMAGEM']; }
    function atendimento() { return ['FUNC_RECEPCAO', 'FUNC_EMERGENCIA', 'COORD_TRIAGEM', 'FUNC_ENFERMAGEM', 'MEDICO']; }
    function imagem() { return ['FUNC_IMAGENOLOGIA', 'FUNC_ULTRASSOM']; }   // setores que atendem a fila de exames e assinam laudos
    function procedimentos() { return ['FUNC_CENTRO_CIRURGICO', 'FUNC_HEMODINAMICA', 'CHEFE_HEMODINAMICA']; }   // Etapa 8: atendem a fila PROCEDIMENTOS (não leem triagens nem o prontuário)
    function apoio() { return ['FUNC_NUTRICAO', 'FUNC_HEMOTERAPIA']; }   // Etapa 8: leem só a internação (paciente e leito) para a dieta e a transfusão
    function farmacia() { return ['CHEFE_FARMACIA', 'FUNC_FARMACIA']; }   // Etapa 7: dispensam o que foi prescrito; leem só prescrições e a internação (nome, leito), nunca o resto do prontuário

    // ---------- Administrador: lê tudo e cria/altera em qualquer coleção, EXCETO nas de registro imutável (histórico, prontuário, chamadas...) e nunca apaga ----------
    match /{col}/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin() && !(col in ['historico_alteracoes', 'registros_clinicos', 'documentos_clinicos', 'prontuarios_abertos', 'sinais_vitais', 'chamadas', 'balanco_hidrico', 'rouparia_mov', 'residuos_registros', 'obito_paciente', 'anexos_clinicos']);
    }

    // ---------- Usuários: só o administrador lê e altera (nunca expor hashes) ----------
    match /app_users/{id} {
      allow read: if ehAdmin() || (logado() && usuario() == id);
      allow create: if ehAdmin();
      allow update: if ehAdmin() || (logado() && usuario() == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));   // o próprio usuário só altera o nome
      allow delete: if false;
    }

    // ---------- Auditoria: qualquer usuário logado grava; só o administrador lê; ninguém altera ou apaga ----------
    match /historico_alteracoes/{id} {
      allow create: if logado();
      allow read: if ehAdmin();
      allow update, delete: if false;
    }

    // ---------- Prontuário: registros assinados só são CRIADOS (sem alterar nem apagar) ----------
    // Etapa 4: o setor de imagem registra o LAUDO (tipo RESULTADO) e só lê registros desse tipo (consulta com where tipo == 'RESULTADO'). RASCUNHO: não testado no emulador.
    // Etapa 7: a Farmácia lê só registros do tipo PRESCRICAO (consulta com where tipo == 'PRESCRICAO'), para dispensar o que foi prescrito.
    // Checagem beira-leito de item de prescrição: documento à parte (a prescrição não muda). Só criação, uma por item (id = <prescrição>_<item>).
    match /checagens_prescricao/{id} {
      allow read: if temAcao(clinico(), 'prontuario_ver') || temPerfil(farmacia());
      allow create: if temAcao(['FUNC_ENFERMAGEM', 'MEDICO'], 'prontuario_evoluir') && request.resource.data.registrado_por == usuario();
      allow update, delete: if false;
    }
    match /registros_clinicos/{id} {
      allow read: if temAcao(clinico(), 'prontuario_ver') || (temPerfil(imagem()) && resource.data.tipo == 'RESULTADO') || (temPerfil(farmacia()) && resource.data.tipo == 'PRESCRICAO');
      // Etapa 8: quem atende Procedimentos grava só o registro do tipo PROCEDIMENTO
      allow create: if (temAcao(clinico(), 'prontuario_evoluir') || (temPerfil(imagem()) && request.resource.data.tipo == 'RESULTADO') || (temPerfil(procedimentos()) && request.resource.data.tipo == 'PROCEDIMENTO'))
        && request.resource.data.autor == usuario()
        && request.resource.data.assinado == true;
      allow update, delete: if false;
    }

    // Anexos do prontuário (#31): o arquivo fica no Storage (storage.rules); aqui só o registro, criado uma vez e nunca alterado nem apagado.
    match /anexos_clinicos/{id} {
      allow read: if temAcao(clinico(), 'prontuario_ver');
      allow create: if temAcao(clinico(), 'prontuario_evoluir') && request.resource.data.autor == usuario();
      allow update, delete: if false;
    }

    // Documentos emitidos ao paciente (receita, atestado, encaminhamento, declaração de comparecimento): só são criados, nunca alterados nem apagados.
    // A recepção emite apenas a declaração de comparecimento (sem dados clínicos). RASCUNHO: não testado no emulador.
    match /documentos_clinicos/{id} {
      allow read: if temPerfil(clinico()) || (temPerfil(['FUNC_RECEPCAO']) && resource.data.tipo == 'COMPARECIMENTO');
      allow create: if (temPerfil(['MEDICO']) || (temPerfil(['FUNC_RECEPCAO']) && request.resource.data.tipo == 'COMPARECIMENTO'))
        && request.resource.data.emitido_por == usuario();
      allow update, delete: if false;
    }

    // ---------- Leitos e internações ----------
    // Etapa 5 (fila de leito e painel de disponibilidade): alocar um leito é UMA transação que grava `internacoes`, `leitos_estado`, `internacao_ativa`
    // e atualiza o `atendimentos` (fila INTERNACAO), por isso os perfis abaixo precisam das 4 permissões juntas (Enfermagem e Recepção as têm).
    // O painel de disponibilidade lê só `leitos_estado` e `cad_leito`, sem dados de paciente. RASCUNHO: não testado no emulador; as regras não conferem
    // a ordem da fila nem o motivo da alocação (isso é validado no serviço `alocarLeitoDaFila`).
    // Estrutura física gravada no banco (#39): leitura para quem lê os leitos; só o Administrador grava; nunca apaga.
    // Permissões editáveis (#5): todo usuário logado lê (a tela precisa); só o Administrador grava; nunca apaga.
    match /config_permissoes/{id} {
      allow read: if logado();
      allow create, update: if perfil() == 'ADMIN';
      allow delete: if false;
    }
    match /leitos_estrutura/{id} {
      allow read: if temPerfil(leitos()) || temPerfil(farmacia()) || temPerfil(['DIRETORIA']);
      allow create, update: if perfil() == 'ADMIN';
      allow delete: if false;
    }
    match /leitos_estado/{id} {
      allow read: if temAcao(leitos(), 'mapa_ver') || temPerfil(farmacia()) || temPerfil(['DIRETORIA']);
      // Etapa 9: o médico muda o leito para higienização só ao registrar um óbito (o serviço grava tudo numa transação).
      allow create, update: if temAcao(['FUNC_ENFERMAGEM', 'FUNC_HIGIENIZACAO', 'FUNC_RECEPCAO'], 'leito_gerenciar')
        || (temPerfil(['MEDICO']) && request.resource.data.status == 'HIGIENIZACAO');
      allow delete: if false;
    }
    match /prontuarios_abertos/{id} {
      allow read: if temPerfil(clinico()) || temPerfil(['FUNC_RECEPCAO']);
      allow create: if temPerfil(clinico());
      allow update, delete: if false;
    }
    match /internacoes/{id} {
      allow read: if temPerfil(leitos()) || temPerfil(farmacia()) || temPerfil(apoio()) || temPerfil(['DIRETORIA']);   // Etapa 10: indicadores da Direção (mesmo aviso dos atendimentos)
      // Etapa 9: o médico só encerra a internação com tipo de alta ÓBITO (registrar óbito); alta comum continua com a enfermagem e a recepção.
      allow create, update: if temPerfil(internacao()) || (temPerfil(['MEDICO']) && request.resource.data.tipo_alta == 'OBITO');
      allow delete: if false;
    }
    match /internacao_ativa/{id} {
      allow read, create, update: if temPerfil(internacao()) || (temPerfil(['MEDICO']) && request.resource.data.obito == true);
      allow delete: if false;
    }

    // ---------- Enfermagem (Etapa 6): sinais vitais, checagem de medicação e cuidados, passagem de plantão ----------
    // RASCUNHO: não testado no emulador. Sinais vitais e checagens nunca são apagados; uma medição errada é corrigida com uma nova medição (o serviço exige a observação).
    // A decisão de uma checagem (administrar, não administrar, suspender) é uma transação que relê o documento: aqui só se confere o perfil.
    match /sinais_vitais/{id} {
      allow read: if temAcao(['FUNC_ENFERMAGEM', 'MEDICO'], 'enfermagem_ver');
      allow create: if temAcao(['FUNC_ENFERMAGEM'], 'enfermagem_registrar') && request.resource.data.por == usuario();
      allow update, delete: if false;
    }
    // #46: processo de enfermagem e curativos. Só criação; erro = anulação por novo documento.
    match /processo_enfermagem/{id} {
      allow read: if temAcao(['FUNC_ENFERMAGEM', 'MEDICO'], 'enfermagem_ver');
      allow create: if temAcao(['FUNC_ENFERMAGEM'], 'enfermagem_registrar') && request.resource.data.por == usuario();
      allow update, delete: if false;
    }
    match /curativos_enfermagem/{id} {
      allow read: if temAcao(['FUNC_ENFERMAGEM', 'MEDICO'], 'enfermagem_ver');
      allow create: if temAcao(['FUNC_ENFERMAGEM'], 'enfermagem_registrar') && request.resource.data.por == usuario();
      allow update, delete: if false;
    }
    match /checagens/{id} {
      allow read: if temPerfil(['FUNC_ENFERMAGEM', 'MEDICO']);
      allow create, update: if temPerfil(['FUNC_ENFERMAGEM']);
      allow delete: if false;
    }
    match /passagens_plantao/{id} {
      allow read: if temPerfil(['FUNC_ENFERMAGEM', 'MEDICO']);
      allow create, update: if temPerfil(['FUNC_ENFERMAGEM']);
      allow delete: if false;
    }

    // ---------- Exames e autorizações ----------
    match /solicitacoes_exame/{id} {
      allow read: if temPerfil(exames());
      allow create: if temPerfil(['MEDICO']);
      allow update: if temPerfil(exames());
      allow delete: if false;
    }
    match /agenda_vagas/{id} {
      allow read: if temPerfil(exames());
      allow create, update: if temPerfil(['FUNC_IMAGENOLOGIA', 'FUNC_ULTRASSOM']);
      allow delete: if false;
    }
    match /autorizacoes/{id} {
      allow read: if temPerfil(exames());
      allow create, update: if temPerfil(['AUTORIZADOR']);
      allow delete: if false;
    }
    match /config_hospital/{id} {
      allow read: if logado();
      allow create, update: if temPerfil(['AUTORIZADOR']);
    }

    // ---------- Gestão de Transporte (Demandas do NIR) e Farmácia por Pisos ----------
    match /demandas_transporte/{id} {
      allow read: if logado();
      allow create, update: if temPerfil(transporte());
      allow delete: if false;
    }
    match /farmacia_dispensacoes/{id} {
      allow read: if logado();
      allow create, update: if temPerfil(clinico()) || temPerfil(estoque());
      allow delete: if false;
    }

    // ---------- Pacientes e atendimento (dados pessoais: LGPD) ----------
    match /pacientes/{id} {
      // Etapa 8: o centro cirúrgico e a hemodinâmica leem o cadastro ao marcar cirurgia e ao concluir procedimento (Nutrição e Hemoterapia usam só o nome gravado na internação)
      allow read: if temPerfil(atendimento()) || temPerfil(procedimentos());
      allow create, update: if temPerfil(['FUNC_RECEPCAO']);
      allow delete: if false;
    }
    // Atendimento (Etapas 2 e 3): fila, chamadas, triagem clínica e consultas. RASCUNHO: ainda não testado no emulador.
    // `atendimentos` só guarda dados operacionais; os dados clínicos ficam em `triagens` e `consultas`, com leitura mais restrita.
    // Etapa 4: o setor de imagem lê a fila e só altera atendimentos que estão na fila EXAMES (chamar, atender, encerrar ou devolver ao médico).
    // Etapa 8: quem atende Procedimentos lê a fila e só altera atendimentos que estão na fila PROCEDIMENTOS (chamar, atender, concluir ou devolver ao médico).
    match /atendimentos/{id} {
      // Etapa 10: o Painel da Direção lê os atendimentos só para contar. As regras não limitam a "só agregados": a Direção passa a ler o documento inteiro (com nome do paciente). Alternativa: um documento de totais por dia (pendência 75).
      allow read: if temPerfil(atendimento()) || temPerfil(imagem()) || temPerfil(procedimentos()) || temPerfil(['DIRETORIA']);
      allow create: if temPerfil(['FUNC_RECEPCAO']);
      allow update: if temPerfil(['FUNC_RECEPCAO', 'FUNC_EMERGENCIA', 'FUNC_ENFERMAGEM', 'MEDICO'])
        || (temPerfil(imagem()) && resource.data.fila == 'EXAMES')
        || (temPerfil(procedimentos()) && resource.data.fila == 'PROCEDIMENTOS');
      allow delete: if false;
    }
    match /chamadas/{id} {
      allow read: if temPerfil(['FUNC_RECEPCAO', 'FUNC_EMERGENCIA', 'FUNC_ENFERMAGEM', 'MEDICO']) || temPerfil(imagem()) || temPerfil(procedimentos());
      allow create: if temPerfil(['FUNC_EMERGENCIA', 'FUNC_ENFERMAGEM', 'MEDICO']) || temPerfil(imagem()) || temPerfil(procedimentos());
      allow update, delete: if false;
    }
    match /triagens/{id} {
      allow read: if temPerfil(['FUNC_EMERGENCIA', 'FUNC_ENFERMAGEM', 'MEDICO']);
      allow create, update: if temPerfil(['FUNC_EMERGENCIA', 'FUNC_ENFERMAGEM']);
      allow delete: if false;
    }
    match /consultas/{id} {
      allow read, create, update: if temPerfil(['MEDICO']);
      allow delete: if false;
    }
    match /{col}/{id} {
      allow read: if logado() && col in ['registros_recepcao', 'ocorrencias_emergencia', 'funcionarios', 'equipes_triagem', 'composicoes_mensais', 'integrantes_equipes'] && temPerfil(atendimento());
      allow create, update: if logado() && col in ['registros_recepcao', 'ocorrencias_emergencia', 'funcionarios', 'equipes_triagem', 'composicoes_mensais', 'integrantes_equipes'] && temPerfil(atendimento());
    }

    // ---------- Ambulatório e Centro Cirúrgico (Etapa 8). RASCUNHO: não testado no emulador ----------
    // `agenda_slots` são as travas de horário (paciente, profissional e sala): gravadas na mesma transação do agendamento, nunca apagadas (liberar = ocupado: false).
    // O médico altera a consulta só para marcá-la como realizada ao concluir o atendimento (o serviço confere a situação).
    match /agenda_consultas/{id} {
      allow read: if temPerfil(['FUNC_RECEPCAO', 'MEDICO', 'FUNC_ENFERMAGEM']);
      allow create: if temPerfil(['FUNC_RECEPCAO']);
      allow update: if temPerfil(['FUNC_RECEPCAO', 'MEDICO']);
      allow delete: if false;
    }
    match /agenda_slots/{id} {
      allow read, create, update: if temPerfil(['FUNC_RECEPCAO', 'FUNC_CENTRO_CIRURGICO']);
      allow delete: if false;
    }
    // Cirurgia: o centro cirúrgico marca e cancela; a enfermagem assina o checklist, inicia, avalia a RPA e dá a alta (o serviço confere a situação em transação).
    // O checklist e as avaliações só acrescentam dentro do documento; as regras não conferem isso (validado no serviço).
    match /cirurgias/{id} {
      allow read: if temAcao(['FUNC_CENTRO_CIRURGICO', 'FUNC_ENFERMAGEM', 'MEDICO'], 'cirurgia_ver');
      allow create: if temAcao(['FUNC_CENTRO_CIRURGICO'], 'cirurgia_gerenciar');
      allow update: if temAcao(['FUNC_CENTRO_CIRURGICO', 'FUNC_ENFERMAGEM'], 'cirurgia_registrar');
      allow delete: if false;
    }

    // ---------- UTI, Nutrição e Hemoterapia (Etapa 8). RASCUNHO: não testado no emulador ----------
    // Balanço hídrico e dispositivos nunca são apagados: lançamento errado é anulado por um novo registro (id anul_<id>), retirada de dispositivo é um update com motivo.
    match /balanco_hidrico/{id} {
      allow read: if temPerfil(['FUNC_ENFERMAGEM', 'MEDICO']);
      allow create: if temPerfil(['FUNC_ENFERMAGEM']) && request.resource.data.por == usuario();
      allow update, delete: if false;
    }
    match /dispositivos/{id} {
      allow read: if temPerfil(['FUNC_ENFERMAGEM', 'MEDICO']);
      allow create, update: if temPerfil(['FUNC_ENFERMAGEM']);
      allow delete: if false;
    }
    // Dieta: o médico e a Nutrição prescrevem; `dieta_ativa/{internacao}` é o ponteiro da dieta vigente (uma por internação).
    match /dietas/{id} {
      allow read: if temAcao(['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_NUTRICAO'], 'dieta_ver');
      allow create, update: if temAcao(['MEDICO', 'FUNC_NUTRICAO'], 'dieta_prescrever');
      allow delete: if false;
    }
    match /dieta_ativa/{id} {
      allow read: if temPerfil(['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_NUTRICAO']);
      allow create, update: if temPerfil(['MEDICO', 'FUNC_NUTRICAO']);
      allow delete: if false;
    }
    // Transfusão: o médico solicita; a agência reserva e entrega a bolsa (id = número da bolsa: o mesmo número não entra duas vezes); a enfermagem transfunde.
    // A conferência por um segundo profissional e a ordem dos passos são validadas no serviço (as regras só conferem o perfil).
    match /solicitacoes_transfusao/{id} {
      allow read: if temAcao(['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_HEMOTERAPIA'], 'hemoterapia_ver');
      allow create: if temAcao(['MEDICO'], 'hemoterapia_solicitar');
      allow update: if temAcao(['MEDICO', 'FUNC_HEMOTERAPIA', 'FUNC_ENFERMAGEM'], 'hemoterapia_transfundir');
      allow delete: if false;
    }
    match /bolsas_sangue/{id} {
      allow read: if temPerfil(['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_HEMOTERAPIA']);
      allow create: if temPerfil(['FUNC_HEMOTERAPIA']);
      allow update: if temPerfil(['FUNC_HEMOTERAPIA', 'FUNC_ENFERMAGEM']);
      allow delete: if false;
    }

    // ---------- Farmácia (Etapa 7): dispensação e requisição. RASCUNHO: não testado no emulador ----------
    // A dispensação traz o nome do paciente: só a Farmácia e a Enfermagem leem (a checagem de medicação mostra se o item já foi dispensado). Nunca é apagada;
    // o cancelamento (estorno do estoque) é um update feito pelo Chefe da Farmácia e grava também um `cad_cancelamento`.
    // O saldo do lote é baixado em `products`/`product_batches`, que já aceitam qualquer usuário logado (ver o bloco de estoque abaixo).
    match /cad_dispensacao/{id} {
      allow read: if temPerfil(farmacia()) || temPerfil(['FUNC_ENFERMAGEM']);
      allow create: if temPerfil(farmacia());
      allow update: if temPerfil(['CHEFE_FARMACIA']);
      allow delete: if false;
    }
    match /cad_requisicao/{id} {
      allow read: if temPerfil(farmacia()) || temPerfil(['FUNC_ENFERMAGEM']);
      allow create: if temPerfil(farmacia()) || temPerfil(['FUNC_ENFERMAGEM']);
      allow update: if temPerfil(farmacia());
      allow delete: if false;
    }
    // Interações medicamentosas: a Farmácia cadastra; quem prescreve e checa lê. Nunca é apagada (inativar = update).
    match /cad_interacao/{id} {
      allow read: if logado();
      allow create, update: if temPerfil(['CHEFE_FARMACIA']);
      allow delete: if false;
    }
    match /cad_cancelamento/{id} {
      allow create: if temPerfil(['CHEFE_FARMACIA']);
    }

    // ---------- Apoio e infraestrutura (Etapa 9). RASCUNHO: não testado no emulador ----------
    // Nada é apagado. Ordens de serviço: qualquer usuário logado abre chamado e lê (o chamado traz só equipamento/local, nunca paciente); só a manutenção
    // atende, conclui e cancela (o autor também pode cancelar o próprio chamado ainda aberto). As transições são validadas no serviço.
    match /os_manutencao/{id} {
      allow read, create: if logado();
      allow update: if temPerfil(['FUNC_MANUTENCAO']) || (logado() && resource.data.solicitante == usuario());
      allow delete: if false;
    }
    // #69: movimentações e testes elétricos do equipamento. Livros só de criação (erro = anulação por novo documento).
    match /equipamento_movimentacoes/{id} {
      allow read: if logado();
      allow create: if temAcao(['FUNC_MANUTENCAO'], 'manutencao_gerenciar');
      allow update, delete: if false;
    }
    match /equipamento_testes_eletricos/{id} {
      allow read: if logado();
      allow create: if temAcao(['FUNC_MANUTENCAO'], 'manutencao_executar');
      allow update, delete: if false;
    }
    match /manut_planos/{id} {
      allow read: if temPerfil(['FUNC_MANUTENCAO', 'CHEFE_HEMODINAMICA']);
      allow create, update: if temAcao(['FUNC_MANUTENCAO'], 'manutencao_gerenciar');
      allow delete: if false;
    }
    // Transporte: quem solicita lê o que abriu; a equipe de transporte lê e atende tudo. O serviço restringe o transporte de paciente a certos perfis.
    // Laboratório (#29): o médico pede, a enfermagem lê; o laboratório coleta e libera. Um resultado liberado não muda mais; ninguém apaga.
    match /lab_pedidos/{id} {
      allow read: if temAcao(['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_LABORATORIO'], 'laboratorio_ver');
      allow create: if temPerfil(['MEDICO']) && request.resource.data.status == 'SOLICITADO' && request.resource.data.solicitante == usuario();
      allow update: if resource.data.status != 'LIBERADO' && resource.data.status != 'CANCELADO'
        && (temPerfil(['FUNC_LABORATORIO']) || (temPerfil(['MEDICO']) && resource.data.solicitante == usuario() && request.resource.data.status == 'CANCELADO'));
      allow delete: if false;
    }
    // Retificação de resultado de laboratório: só criação (o resultado original fica intacto).
    match /lab_retificacoes/{id} {
      allow read: if temAcao(['MEDICO', 'FUNC_ENFERMAGEM', 'FUNC_LABORATORIO'], 'laboratorio_ver');
      allow create: if temAcao(['FUNC_LABORATORIO'], 'laboratorio_executar') && request.resource.data.por == usuario();
      allow update, delete: if false;
    }
    match /transportes/{id} {
      allow read: if temPerfil(['FUNC_TRANSPORTE']) || (logado() && resource.data.solicitante == usuario());
      allow create: if logado();
      allow update: if temPerfil(['FUNC_TRANSPORTE']) || (logado() && resource.data.solicitante == usuario());
      allow delete: if false;
    }
    // Rouparia e resíduos: livros que só acrescentam (a anulação é um documento novo anul_<id>), por isso não há update.
    match /rouparia_mov/{id} {
      allow read, create: if temPerfil(['FUNC_LAVANDERIA', 'FUNC_HIGIENIZACAO']);
      allow update, delete: if false;
    }
    match /residuos_registros/{id} {
      allow read, create: if temPerfil(['FUNC_HIGIENIZACAO']);
      allow update, delete: if false;
    }
    // Voluntariado: cadastro e presença pelo perfil de voluntariado; a portaria também registra entrada e saída. voluntario_aberta é a trava de uma presença aberta por vez.
    match /voluntarios/{id} {
      allow read: if temPerfil(['FUNC_VOLUNTARIADO', 'FUNC_PORTARIA', 'CHEFE_PORTARIA']);
      allow create, update: if temPerfil(['FUNC_VOLUNTARIADO']);
      allow delete: if false;
    }
    match /voluntario_presencas/{id} {
      allow read, create, update: if temPerfil(['FUNC_VOLUNTARIADO', 'FUNC_PORTARIA', 'CHEFE_PORTARIA']);
      allow delete: if false;
    }
    match /voluntario_aberta/{id} {
      allow read, create, update: if temPerfil(['FUNC_VOLUNTARIADO', 'FUNC_PORTARIA', 'CHEFE_PORTARIA']);
      allow delete: if false;
    }
    // ÓBITOS: dado sigiloso. Só médico e enfermagem leem; o médico registra; a enfermagem acompanha (comunicação à família e liberação do corpo).
    // Quem pode fazer cada passo e a retificação do nº da DO (com motivo) são validados no serviço. Os acessos ficam em auditoria.
    match /obitos/{id} {
      allow read: if temAcao(['MEDICO', 'FUNC_ENFERMAGEM'], 'obito_ver');
      allow create: if temAcao(['MEDICO'], 'obito_registrar');
      allow update: if temAcao(['MEDICO', 'FUNC_ENFERMAGEM'], 'obito_acompanhar');
      allow delete: if false;
    }
    match /obito_paciente/{id} {
      // #68: qualquer usuário logado confere se o paciente tem óbito registrado (leitura de UM documento, sem dado clínico) para o bloqueio de novos atendimentos; a lista continua restrita.
      allow get: if logado();
      allow list: if temPerfil(['MEDICO', 'FUNC_ENFERMAGEM']);
      allow create: if temPerfil(['MEDICO']);
      allow update, delete: if false;
    }

    // ---------- Gestão (Etapa 10). RASCUNHO: não testado no emulador ----------
    // Nada é apagado. Ouvidoria: só a ouvidoria e a direção leem; só a ouvidoria grava. A identidade de quem se manifestou NÃO se protege por campo
    // nas regras (o Firestore lê o documento inteiro): a tela esconde o nome da Direção, mas quem lê a coleção direto vê o nome. Antes de publicar,
    // separar a identidade em outra coleção (pendência 76).
    match /ouvidoria/{id} {
      allow read: if temPerfil(['FUNC_OUVIDORIA', 'DIRETORIA']);
      allow create, update: if temPerfil(['FUNC_OUVIDORIA']);
      allow delete: if false;
    }
    // Qualidade e ensino e pesquisa: a equipe grava; a Direção só lê.
    match /qualidade_nc/{id} {
      allow read: if temPerfil(['FUNC_QUALIDADE', 'DIRETORIA']);
      allow create, update: if temPerfil(['FUNC_QUALIDADE']);
      allow delete: if false;
    }
    match /qualidade_acoes/{id} {
      allow read: if temPerfil(['FUNC_QUALIDADE', 'DIRETORIA']);
      allow create, update: if temPerfil(['FUNC_QUALIDADE']);
      allow delete: if false;
    }
    match /qualidade_docs/{id} {
      allow read: if temPerfil(['FUNC_QUALIDADE', 'DIRETORIA']);
      allow create, update: if temPerfil(['FUNC_QUALIDADE']);
      allow delete: if false;
    }
    match /ensino_pesquisa/{id} {
      allow read: if temPerfil(['FUNC_ENSINO', 'DIRETORIA']);
      allow create, update: if temPerfil(['FUNC_ENSINO']);
      allow delete: if false;
    }

    // ---------- Cadastros (coleções cad_*): contadores e demais cadastros ----------
    // Atenção: `cad_*` só é gravado pelo Chefe OPME (e Administrador); as demais áreas que usam o motor de cadastros (movimentações do estoque, escala de enfermagem etc.)
    // precisam de regra própria antes de publicar. A dispensação tem leitura restrita acima e, por isso, fica fora da leitura geral.
    match /{col}/{id} {
      allow read: if logado() && col.matches('cad_.*') && col != 'cad_dispensacao';
      allow create, update: if col == 'cad_contadores' ? logado() : (col.matches('cad_.*') && (temPerfil(['CHEFE_OPME']) || (col == 'cad_equipamento' && temPerfil(['FUNC_MANUTENCAO']))));
    }

    // ---------- Estoque e demais módulos já existentes ----------
    match /{col}/{id} {
      allow read: if logado() && col in ['products', 'product_batches', 'product_entry_history', 'stock_transfer_history', 'material_requests', 'laudos', 'patients', 'mapa_schedule', 'procedimentos_agendados', 'procedimentos_nao_realizados', 'salas', 'salas_history', 'notifications', 'portaria_visits', 'portaria_config'];
      allow create, update: if logado() && col in ['products', 'product_batches', 'product_entry_history', 'stock_transfer_history', 'material_requests', 'laudos', 'patients', 'mapa_schedule', 'procedimentos_agendados', 'procedimentos_nao_realizados', 'salas', 'salas_history', 'notifications', 'portaria_visits', 'portaria_config'];
      // Correção (achada no teste do emulador): antes este delete valia para QUALQUER coleção (usuários, atendimentos...). Agora só para as do estoque.
      allow delete: if col in ['products', 'product_batches', 'mapa_schedule'] && temPerfil(estoque());
    }

    // Tudo o que não foi listado acima fica NEGADO (padrão do Firestore).
  }
}
